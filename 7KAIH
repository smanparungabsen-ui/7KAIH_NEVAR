<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Administrasi Guru</title>
    <style>
        /* Mengatur agar halaman dan iframe memenuhi seluruh layar tanpa scrollbar ganda */
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #ffffff;
        }
        iframe {
            width: 100%;
            height: 100%;
            border: none;
            display: block;
        }
    </style>
</head>
<body>

    <iframe src="https://script.google.com/macros/s/AKfycbzi5zG_i1MnzeeEAFG3X749REKOjMKD3CW53Us8efXR4b4vz3nn9jMdoMR03-LTtyLE/exec"></iframe>

</body>
</html>
